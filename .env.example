# Copy to .env. Placeholder and development values only. Never commit a real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application role: subject to row-level security.
DATABASE_URL=postgresql+asyncpg://opsassist_app:dev_app_password@localhost:5433/opsassist
# Owner role: migrations only. Do not give this to the running application.
MIGRATION_DATABASE_URL=postgresql+asyncpg://opsassist_owner:dev_owner_password@localhost:5433/opsassist

# Plain-HTTP localhost needs false. Production must leave this true.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173"]

BLOB_DIR=./var/blobs
MAX_UPLOAD_BYTES=26214400

# Model configuration. Safe defaults send nothing anywhere:
#   LLM_PROVIDER=extractive  returns excerpts, no generation
#   EMBEDDING_PROVIDER=hash  deterministic, no semantic value
# Recommended local setup (ollama pull nomic-embed-text; ollama pull llama3):
LLM_PROVIDER=ollama
LLM_MODEL=llama3
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# External providers send organizational data off this machine. Setting this to
# true records an organizational decision: check the vendor's retention and region
# terms first. See docs/SECURITY_MODEL.md section 6.
EXTERNAL_MODEL_DATA_APPROVED=false
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=replace-me
